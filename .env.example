# 1. CLE API GEMINI (AI Studio / Server-side)
# Obtenable gratuitement sur : https://aistudio.google.com/app/apikey
GEMINI_API_KEY="VOTRE_CLE_API_GEMINI"

# 2. URL DE L'APPLICATION EN PRODUCTION
APP_URL="http://localhost:3017"

# 3. CONFIGURATION CLIENT FIREBASE (VITE_)
