VITE_FIREBASE_API_KEY="VOTRE_FIREBASE_API_KEY"
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0077143231"
VITE_FIREBASE_AUTH_DOMAIN="gen-lang-client-0077143231.firebaseapp.com"
VITE_FIREBASE_APP_ID="1:741090241916:web:a415106282524439ba88f9"

# 4. CONFIGURATION OAUTH GOOGLE WORKSPACE / DRIVE
# Obtenable dans : Console GCP > Identifiants > ID client OAuth 2.0
VITE_GOOGLE_CLIENT_ID="741090241916-otmk4abf02hjq97bacuuik0qbg9hctd1.apps.googleusercontent.com"
